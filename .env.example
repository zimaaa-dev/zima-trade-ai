# ============================================================================
# ZIMA-TRADE-AI v4.0 — Шаблон переменных окружения (.env.example)
# Скопируйте этот файл в .env: cp .env.example .env
# НИКОГДА не коммитьте реальный файл .env в публичный GitHub-репозиторий!
# ============================================================================

PORT=3000
APP_URL="http://localhost:3000"

# --- 1. Telegram Bot & Алерты (@zimatradeai_bot) ---
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_BOT_USERNAME="@zimatradeai_bot"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"

# --- 2. Биржевой шлюз Bybit API v5 ---
# Оставьте пустыми для режима обучения (Shadow / Paper Mode по живому стакану L2-50)
# Заполните для боевой торговли (Live Execution с подписью HMAC-SHA256)
BYBIT_API_KEY=""
BYBIT_API_SECRET=""
BYBIT_TESTNET="false"
# Если IP Cloud.ru блокируется CloudFront, укажите URL вашего Cloudflare Worker:
BYBIT_BASE_URL="https://api.bybit.com"

# --- 3. ИИ-Аналитика: Ollama Cloud (Пул ключей с автоматической ротацией) ---
# Поддерживаемые облачные модели (Free Usage Credits):
# nemotron-3-nano:30b (рекомендуется для квант-анализа), gpt-oss:20b, gemma4:31b,
# nemotron-3-super, gpt-oss:120b, nemotron-3-ultra, beam
OLLAMA_HOST="https://ollama.com"
OLLAMA_MODEL="nemotron-3-nano:30b"
# Введите один или несколько ключей через запятую для автоматической ротации при 429 / исчерпании лимитов:
OLLAMA_API_KEYS="key1,key2,key3"
OLLAMA_API_KEY=""

# Резервный уровень: Google Gemini API (опционально)
GEMINI_API_KEY=""

# --- 4. Сторожевой таймер Cloudflare Watchdog ---
WATCHDOG_SECRET="change_me_to_random_sha256_secret"
