# ==============================================================================
# ZimaTrade AI - Environment Configuration
# ==============================================================================

# Node Identification
NODE_ROLE=NODE_A_CLOUD_CORE # Options: NODE_A_CLOUD_CORE, NODE_B_FORGE_GPU
ENVIRONMENT=production

# Exchanges API Keys
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false

OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

MEXC_API_KEY=
MEXC_API_SECRET=

# Telegram UserBot (Telethon) - Read-Only Session
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_SESSION_NAME=zimatrade_userbot

# LLM Providers (Node C: Ollama Pool, Node D: Ollama Cloud)
OLLAMA_ENDPOINTS=http://127.0.0.1:11434
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_MODEL_FAST=gpt-oss:20b
OLLAMA_MODEL_REASONING=gpt-oss:120b

# Risk Firewall Parameters (IMMUTABLE PROCEDURAL LIMITS)
MAX_RISK_PER_TRADE_PCT=0.015 # 1.5% max loss per trade
MAX_DAILY_DRAWDOWN_PCT=0.050 # 5.0% rolling 24h Kill-Switch
MAX_HARD_LEVERAGE=10         # Clamped to 10x max
SPREAD_GUARD_MAX_PCT=0.0025  # 0.25% max allowed spread
FUNDING_GUARD_MINUTES=15     # Lock entries 15 mins before funding
FUNDING_GUARD_MAX_RATE=0.001 # 0.10% threshold

# Storage & Quotas
DATA_DIR=/app/data
SQLITE_DB_PATH=/app/data/sqlite/zimatrade.db
PARQUET_DIR=/app/data/parquet
MAX_LOCAL_STORAGE_GB=10
S3_BUCKET_NAME=zimatrade-archive-s3
S3_ENDPOINT_URL=https://s3.cloud.ru

# Network & Dead-Man's Switch
WATCHDOG_PING_URL=https://zimatrade-watchdog.workers.dev/ping
WATCHDOG_SECRET_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_BOT_TOKEN=
